NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_FORMSPREE_FORM_ID=
NEXT_PUBLIC_MEDIA_USAGE_POLICY=reference-attributed

# Analytics は明示的に有効化したときだけ動く。ID を入れるだけでは送信しない。
# production runtime（Vercel の Production、または VERCEL_ENV 無しの本番ビルド）でのみ有効。
# 実 ID はここに書かない。Vercel の Environment Variables で設定する。
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_VERCEL_ANALYTICS_ENABLED=false

# --- コンテンツ基盤移行（Payload CMS + Supabase Postgres + Vercel Blob） ---
# 資源の詳細・provider・環境別IDは docs/reference/content-platform-resources-v1.md を正本とする。
# 実値はここに書かない。Vercel の Environment Variables で環境（Production / Preview）ごとに設定する。

# Postgres（Supabase）。runtime用はTransaction pooler、migration用はDirect connectionを使う。
DATABASE_URL=
PAYLOAD_SECRET=
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
CONTENT_SOURCE=payload
ALLOW_LOCAL_CONTENT_ROLLBACK=false
REVALIDATION_SECRET=
PREVIEW_TOKEN_SECRET=

# Vercel Blob — public media store（Production / Preview で別store、Vercelが環境ごとに自動注入する
# classic static token）。単一の共通read/write tokenを環境間で共有しない。
BLOB_READ_WRITE_TOKEN=
# Media collectionのstorage adapterを明示的に無効化したい場合だけ false にする（既定はtrue）。
# false でもfield自体は残る（`alwaysInsertFields`）。local storageへfallbackするのはtoken未設定時。
MEDIA_STORAGE_ENABLED=

# Vercel Blob — private audit / backup store（Production / Preview で別store、OIDC-federated方式。
# 長期static tokenは存在せず、Vercel FunctionがVERCEL_OIDC_TOKENをruntimeで交換する）。
# 各変数はVercel project envで対応する環境（Production / Preview）のみへscopeされる。
PRODUCTION_AUDIT_BLOB_TOKEN_STORE_ID=
PRODUCTION_AUDIT_BLOB_TOKEN_WEBHOOK_PUBLIC_KEY=
PREVIEW_AUDIT_BLOB_TOKEN_STORE_ID=
PREVIEW_AUDIT_BLOB_TOKEN_WEBHOOK_PUBLIC_KEY=
# OIDC Blob SDKがこのdeploymentで接続するaudit store。Vercel env scopeごとに、上の対応する
# PRODUCTION/PREVIEW store IDと同じ値を設定する。VERCEL_OIDC_TOKEN自体はVercelが注入する。
BLOB_STORE_ID=

# AWS KMS。snapshot/manifest署名用はARN、監査暗号化用はkey alias/ARN。用途ごとに別key ID。
SNAPSHOT_SIGNING_KMS_KEY_ARN=
# 署名鍵をrotationした場合だけ、対応する公開鍵PEMの絶対pathを設定する。未設定時はrepository内の
# documented public keyを使う。KMS keyだけ変えて公開鍵を変えない構成は検証不能なので禁止。
SNAPSHOT_SIGNING_PUBLIC_KEY_PATH=
AUDIT_OUTBOX_KMS_KEY_ID=

# --- Codex MCP（Task 8） ---
# Payload MCP serverは PAYLOAD_PUBLIC_SERVER_URL と同一origin の /api/mcp。API keyは
# `payload-mcp-api-keys` collectionが発行するhashed値で、実値はこのファイル・Vercel環境変数・
# チャット・監査artifactのどこにも書かない（.codex/content-workflow.md参照）。
# 通常profile（content-draft-writerへbind）と管理用profile（platform-adminへbind、統合試験専用）
# は別々に発行・別々に保管する。下の変数は tests/integration/mcp-endpoint.test.ts をローカルで
# 手動実行する際、使い捨てtest DB上のkeyを一時的に渡すためだけのプレースホルダ（命名は
# REVALIDATION_SECRET 等の既存慣習に合わせた）。空のままcommitする。
PAYLOAD_MCP_LOCAL_TEST_API_KEY=
PAYLOAD_MCP_LOCAL_TEST_ADMIN_API_KEY=

# --- version保持ポリシー（remediation group 1 / 必須修正3） ---
# 既定は「無制限保持・自動prune無効」。古いversionの自動削除は、pruneで消える分を
# 署名済みprivate audit archiveへ書き出せる状態が揃うまで**有効にしない**（fail-closed）。
# `CONTENT_VERSION_PRUNE_MAX_PER_DOC` を設定しても、下の2つが揃っていなければ
# `resolveVersionRetention()`（lib/payload/access.ts）が無制限保持へ倒す。
CONTENT_VERSION_PRUNE_MAX_PER_DOC=
# version archiveの署名に使うKMS key（`SNAPSHOT_SIGNING_KMS_KEY_ARN` とは用途が別）。
AUDIT_ARCHIVE_SIGNING_KMS_KEY_ID=
# archive保存後の読み戻し・署名検証を有効化したときだけ 'true'。
AUDIT_ARCHIVE_VERIFICATION_ENABLED=
