{
  "name": "deploid_tob",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node --experimental-strip-types scripts/validate-data.mjs && next build",
    "start": "next start",
    "validate:data": "node --experimental-strip-types scripts/validate-data.mjs",
    "build:data-r01-manifest": "node --experimental-strip-types scripts/build-data-r01-manifest.mjs",
    "build:data-r02-manifest": "node --experimental-strip-types scripts/build-data-r02-manifest.mjs",
    "parse:robot-db": "node --experimental-strip-types scripts/parse-robot-db.ts",
    "report:robot-db-diff": "node --experimental-strip-types scripts/report-robot-db-diff.mjs",
    "check:source-links": "node --experimental-strip-types scripts/check-source-links.mjs",
    "check:data-boundaries": "node scripts/check-data-import-boundaries.mjs",
    "check:client-imports": "node scripts/check-client-import-graph.mjs",
    "generate:world-map": "node --experimental-strip-types scripts/generate-world-map-asset.mjs",
    "check:world-map-asset": "node --experimental-strip-types scripts/generate-world-map-asset.mjs --check",
    "check:home-payload": "node scripts/check-home-payload.mjs",
    "check:bundle-content": "node --experimental-strip-types scripts/check-client-bundle-content.mjs",
    "check:plan-snippets": "node scripts/check-plan-snippets.mjs",
    "check:dead-code": "knip",
    "check:docs": "node scripts/check-doc-links.mjs",
    "write:refactor-results": "node scripts/write-refactor-results.mjs",
    "check:client-budgets": "node scripts/check-client-budgets.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "eslint . --max-warnings 4",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run validate:data && npm run check:data-boundaries && npm run check:client-imports && npm run check:world-map-asset && npm run typecheck && npm run lint && npm run check:plan-snippets && npm run check:dead-code && npm run check:docs && npm run test && npm run build && npm run check:home-payload && npm run check:bundle-content && npm run check:client-budgets && npm run test:e2e"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@formspree/react": "^3.0.0",
    "@radix-ui/colors": "^3.0.0",
    "@vercel/analytics": "^2.0.1",
    "budoux": "^0.8.4",
    "clsx": "^2.1.1",
    "dotted-map": "^3.1.0",
    "embla-carousel": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.487.0",
    "minisearch": "^7.2.0",
    "motion": "^12.40.0",
    "next": "^16.2.12",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "jsdom": "^28.1.0",
    "knip": "^5.88.1",
    "tailwindcss": "^4.1.12",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "next": {
      "sharp": "^0.35.3",
      "postcss": "^8.5.24"
    },
    "gaxios": {
      "uuid": "^11.1.1"
    },
    "google-artifactregistry-auth": {
      "js-yaml": "^4.3.0"
    }
  }
}
